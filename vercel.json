{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/fonts/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/vendor/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/vendor/hyphenopoly/patterns/(.*).wasm", "headers": [ { "key": "Content-Type", "value": "application/wasm" } ] },
    { "source": "/img/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
  ]
}
